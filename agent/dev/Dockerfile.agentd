# Development agentd / test runner: unprivileged, no Docker socket.
FROM python:3.12-slim
RUN pip install --no-cache-dir pynacl==1.6.2 jsonschema==4.26.0 rfc8785==0.1.4 pyrage==1.4.0 \
        "psycopg[binary]==3.3.6" docker==7.2.0 boto3==1.43.118 cryptography==50.0.2 pytest
USER 1000:1000
WORKDIR /src
ENV PYTHONPATH=/src PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
