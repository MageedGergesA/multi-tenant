# ctl-1's secrets (ADR-006): /etc/ctl/secrets.sops.yaml, decrypted with the
# host's age key, one file per key in /run/ctl (tmpfs), mode 0400, for the ctl
# user only. Stopping this unit removes /run/ctl and, through BindsTo=, stops
# ctl.service.
[Unit]
Description=ctl-1 secrets onto tmpfs
Documentation=file:///opt/ctl/README.md
ConditionPathExists=/etc/ctl/host.agekey

[Service]
Type=oneshot
RemainAfterExit=yes
RuntimeDirectory=ctl
RuntimeDirectoryMode=0700
Environment=SOPS_AGE_KEY_FILE=/etc/ctl/host.agekey
ExecStart=/usr/local/lib/ctl/write-secrets --sops-file /etc/ctl/secrets.sops.yaml --dir /run/ctl --user ctl
UMask=0077
# Root, but only to chown what it writes: age keys need no network.
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/run/ctl
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Not ~@privileged: that set includes @chown, which this unit is for.
SystemCallFilter=~@resources @mount @module @raw-io @reboot @swap @clock @debug @cpu-emulation @obsolete
# sops (and age) are Go: the runtime raises its open-file limit at startup and
# is killed (SIGSYS) without setrlimit; the rest of @resources stays denied.
SystemCallFilter=setrlimit

[Install]
WantedBy=multi-user.target
