#!/usr/bin/python3 -I
"""pgbackrest-backup.service's ExecStart (as postgres): one daily run that chooses its type, so a
full and a differential never compete for the backup lock after downtime (DOC-05 §2: full weekly,
differential the other days). Full on the full day, or when the cluster now in use has no full
newer than FULL_EVERY; differential otherwise.

    pgbackrest-scheduled --stanza main --full-day 6 --lock /var/lib/pgbackrest-lock/backup.lock

The backup runs holding `--lock` (flock), which the db agent takes while ctl-1 expires
(L2.Hold): pgBackRest's own locks are per host, so this keeps the two apart. Taken by a hold,
it waits up to `--lock-wait` seconds, then fails (and the unit retries).
"""
import argparse
import fcntl
import json
import os
import subprocess
import sys
import time

FULL_EVERY = 6.5 * 86400


def choose(info: dict | None, now: float, full_day: int) -> str:
    if time.gmtime(now).tm_wday == full_day or not info or (info.get('status') or {}).get('code') != 0:
        return 'full'
    ids = [d['id'] for d in info.get('db') or []]
    current = max(ids, default=None)
    fulls = [b['timestamp']['stop'] for b in info.get('backup') or []
             if b.get('type') == 'full' and not b.get('error') and (b.get('database') or {}).get('id') == current]
    return 'full' if not fulls or now - max(fulls) >= FULL_EVERY else 'diff'


def take(path: str, wait: float) -> int:
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    deadline = time.monotonic() + wait
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd
        except BlockingIOError:
            if time.monotonic() >= deadline:
                os.close(fd)
                raise SystemExit('pgbackrest-scheduled: %s held for %ds (an L2 hold for expire?)' % (path, wait))
            time.sleep(5)


def main(argv=None) -> int:
    p = argparse.ArgumentParser(prog='pgbackrest-scheduled')
    p.add_argument('--stanza', required=True)
    p.add_argument('--full-day', type=int, default=6, choices=range(7))
    p.add_argument('--lock', required=True)
    p.add_argument('--lock-wait', type=float, default=3600)
    args = p.parse_args(argv)
    take(args.lock, args.lock_wait)       # held until this process exits
    run = subprocess.run(['pgbackrest', '--stanza=%s' % args.stanza, '--output=json', 'info'],
                         capture_output=True, text=True)
    try:
        info = json.loads(run.stdout)[0] if run.returncode == 0 else None
    except (ValueError, IndexError):
        info = None
    kind = choose(info, time.time(), args.full_day)
    print('pgbackrest-scheduled: %s backup' % kind, flush=True)
    # A child, not exec: the lock stays with this process for the whole backup.
    return subprocess.run(['pgbackrest', '--stanza=%s' % args.stanza, '--type=%s' % kind, 'backup']).returncode


if __name__ == '__main__':
    sys.exit(main())
