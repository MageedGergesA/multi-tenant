# {{ ansible_managed }}: infra/ansible role pgbackrest. A WAL switch and an archive check: even an
# idle cluster stores a segment every few minutes, and archiving is verified end to end.
[Unit]
Description=pgBackRest check ({{ pgbackrest_stanza }})
After=postgresql@{{ pgbackrest_pg_version }}-main.service
Requires=postgresql@{{ pgbackrest_pg_version }}-main.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/bin/pgbackrest --stanza={{ pgbackrest_stanza }} check
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
